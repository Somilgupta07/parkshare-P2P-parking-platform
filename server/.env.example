NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://parkshare:parkshare@localhost:5432/parkshare
REDIS_URL=redis://localhost:6379

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_change_me_change_me_change_me
OTP_SECRET=change_me_otp_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
OTP_TTL_SECONDS=300

# dev only: returns the OTP in the API response (ignored in production)
OTP_DEV_ECHO=true
SMS_PROVIDER=console

# comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# use "none" only when client and API are on different sites (needs HTTPS)
COOKIE_SAMESITE=lax

# phone of the seeded admin user (E.164)
ADMIN_PHONE=+919999999999
